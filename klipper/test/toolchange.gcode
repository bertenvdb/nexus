; Pickup from empty, change T1 -> T2 with offsets and Z babystep, park,
; pressure advance routing. Dock X: 40 + 40 * n, dock Y -13, lane Y30.
; EXPECT: MOVE G1 Y30.0 F18000
; EXPECT: MOVE G1 X80.0 F18000
; EXPECT: MOVE G1 Y0.0 E8.000 F18000
; EXPECT: MOVE G1 Y-11.0 E-8.000 F10000
; EXPECT: MOVE G1 Y-13.0 F3000
; EXPECT: MOVE G1 Y20.0 E7.000 F10000
; EXPECT: MOVE G1 Y-9.0 E-4.000 F12000
; EXPECT: MOVE G1 Y-13.0 E-3.000 F5000
; EXPECT: MOVE G1 X120.0 F18000
; EXPECT: MOVE G1 X100.0 Y100.0 F18000
; EXPECT: gcode homing: X:1.500000 Y:0.000000 Z:0.150000
; EXPECT: Extruder 'nexus_extruder' now syncing with 'extruder2'
; EXPECT: Extruder 'nexus_extruder' now syncing with ''
; EXPECT: mounted: none
; EXPECT: toolhead: X:120.000000 Y:30.000000 Z:10.100000
; EXPECT: pressure_advance: 0.050000
; REJECT: Error evaluating
_NEXUS_CONFIG_CHECK
_NEXUS_RESTORE_TOOL
SET_GCODE_VARIABLE MACRO=_NEXUS_STATE VARIABLE=selftest VALUE="'passed'"
SET_GCODE_VARIABLE MACRO=_NEXUS_T2 VARIABLE=offset_x VALUE=1.5
SET_GCODE_VARIABLE MACRO=_NEXUS_T2 VARIABLE=offset_z VALUE=0.1
G28
G1 X100 Y100 Z10 F6000
M104 T1 S220
M104 T2 S220
T1
SET_GCODE_OFFSET Z_ADJUST=0.05
T2
GET_POSITION
SET_PRESSURE_ADVANCE ADVANCE=0.05
SET_PRESSURE_ADVANCE ADVANCE=0.05 EXTRUDER=extruder2
NEXUS_PARK_TOOL
GET_POSITION
NEXUS_STATUS
SET_PRESSURE_ADVANCE EXTRUDER=nexus_extruder ADVANCE=0.05
