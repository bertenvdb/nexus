	(text "XT30 male on the board. Input fuse 5 A 1206 (same part as the tool board channel fuse).\nReverse polarity: one BSC016N06NS with its SOURCE at the input (design 20 §4).\nPower-up: body diode conducts, LM74502 then turns the FET on (Rds 1.6 mOhm).\nReverse polarity: body diode blocks, GATE held at SRC. EN tied to VS (always on), OV to GND.\nBulk electrolytic after the protection, so it never sees reverse voltage."
		(exclude_from_sim no)
		(at 38.1 167.64 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "9e67dab1-e195-55ab-951c-5cdbd74be64a")
	)
