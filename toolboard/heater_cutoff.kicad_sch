	(text "Rail sense (AD-13): 24 V -> 2.18 V, clamp ~36 V. Bleeder 4.7k: <2 V within ~0.25 s\nafter the cutoff opens (recheck with the final rail capacitance)."
		(exclude_from_sim no)
		(at 154.94 190.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "2c34739f-993e-5b68-b0a1-c67ad571d3b6")
	)
	(text "Q1 drain at +24V_IN, Q2 drain at +24V_HEATER, sources joined (back-to-back).\nEN low (MCU reset, Klipper shutdown) -> gate pulled to SRC within ~2 us.\nDefault off: 100k pull-down on HEATER_EN. Klipper: output_pin heater_enable,\nvalue 1, shutdown_value 0. Slow gate drive (60 uA) = soft start of the bulk caps."
		(exclude_from_sim no)
		(at 40.64 190.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "9276e46a-947a-5c1c-a0ff-23a4e92e16ed")
	)
